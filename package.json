{
  "name": "patty",
  "version": "2.0.19",
  "description": "Patty",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-conpty.mjs --postinstall",
    "prepare:conpty": "node scripts/prepare-conpty.mjs",
    "check:conpty": "node scripts/prepare-conpty.mjs --check",
    "dev": "tauri dev",
    "build": "vite build",
    "build:e2e": "tauri build --no-bundle --features e2e",
    "build:benchmark": "tauri build --no-bundle --features e2e --config src-tauri/tauri.benchmark.conf.json",
    "build:integration": "tauri build --no-bundle --features e2e --config src-tauri/tauri.integration.conf.json",
    "test:e2e:notifications": "node e2e/notification-activation.test.mjs",
    "test:e2e:omp": "node e2e/omp-navigation.test.mjs",
    "test:e2e:omp-hook": "node e2e/omp-hook-install.test.mjs",
    "omp:bundle": "node scripts/build-omp-hook.mjs",
    "omp:legacy:prepare": "node integrations/omp/prepare.mjs && node integrations/omp/runtime.mjs && node integrations/omp/apply.mjs",
    "omp:legacy:start": "node integrations/omp/start.mjs",
    "test:omp": "node scripts/test-omp-companion.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.test.mjs",
    "test:e2e:graphite": "node e2e/graphite.test.mjs",
    "test:e2e:sessions": "node e2e/session-workflow.test.mjs",
    "test:e2e:isolation": "node e2e/isolation.test.mjs",
    "test:visual:workbench": "node e2e/workbench-visual.test.mjs",
    "benchmark:startup": "node scripts/benchmark-startup.mjs",
    "benchmark:terminals": "node scripts/benchmark-terminals.mjs",
    "typecheck": "tsc -b --noEmit",
    "check:comments": "node scripts/no-comments.mjs --check",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "package": "tauri build",
    "package:nsis": "tauri build --bundles nsis",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.344",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.7.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.17.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9",
    "ws": "^8.21.3"
  }
}
